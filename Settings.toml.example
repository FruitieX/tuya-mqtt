[mqtt]
id = "tuya-mqtt"
host = "test.mosquitto.org"
port = 1883

# Optional broker credentials; leave out to connect anonymously
# username = "example"
# password = "secret"

# Topic that will be subscribed to. First plus sign will be replaced with device
# id when publishing device updates.
topic = "home/lights/tuya/+"

[devices]
bf0000000000000000aaaa = { name = "Lower bathroom downlight 1", version = "3.3", ip = "192.0.2.11", local_key = "your-16-char-key" }
bf0000000000000000bbbb = { name = "Lower bathroom downlight 2", version = "3.3", ip = "192.0.2.12", local_key = "your-16-char-key" }
bf0000000000000000cccc = { name = "Entryway downlight 1", version = "3.4", ip = "192.0.2.13", local_key = "your-16-char-key" }

# You can override topics for individual devices if you want.  Note that a
# separate topic with a `/set` postfix is used automatically for setting device
# values.
bf0000000000000000dddd = { topic = "my/custom/topic", name = "Entryway downlight 2", version = "3.4", ip = "192.0.2.14", local_key = "your-16-char-key" }
